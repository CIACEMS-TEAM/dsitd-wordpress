{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "dsitd/carrousel",
	"title": "Carrousel des actualités",
	"category": "theme",
	"icon": "admin-site-alt3",
	"description": "Articles épinglés (ou les plus récents) avec image à la une.",
	"textdomain": "dsitd",
	"attributes": {
		"nombre": {
			"type": "integer",
			"default": 5
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"spacing": {
			"margin": true
		}
	},
	"editorScript": "dsitd-blocks-editor",
	"render": "file:./render.php",
	"viewScript": "dsitd-carrousel"
}