{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "800px",
			"wideSize": "1280px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"customGradient": false,
			"palette": [
				{
					"slug": "vert",
					"color": "#0F7705",
					"name": "Vert (principal)"
				},
				{
					"slug": "vert-fonce",
					"color": "#0A5C03",
					"name": "Vert foncé"
				},
				{
					"slug": "orange",
					"color": "#EF7D00",
					"name": "Orange titres (gros caractères uniquement)"
				},
				{
					"slug": "orange-bouton",
					"color": "#E98F30",
					"name": "Orange bouton"
				},
				{
					"slug": "orange-clair",
					"color": "#FFD9AE",
					"name": "Orange clair"
				},
				{
					"slug": "rouge",
					"color": "#D80000",
					"name": "Rouge Flash"
				},
				{
					"slug": "rouge-fonce",
					"color": "#B00000",
					"name": "Rouge foncé"
				},
				{
					"slug": "texte",
					"color": "#212529",
					"name": "Texte"
				},
				{
					"slug": "gris-fonce",
					"color": "#414141",
					"name": "Gris foncé"
				},
				{
					"slug": "gris",
					"color": "#525252",
					"name": "Gris"
				},
				{
					"slug": "gris-bordure",
					"color": "#E8E8E8",
					"name": "Gris bordure"
				},
				{
					"slug": "fond-gris",
					"color": "#F5F5F5",
					"name": "Fond gris"
				},
				{
					"slug": "noir",
					"color": "#0B0B0B",
					"name": "Noir (pied de page)"
				},
				{
					"slug": "blanc",
					"color": "#FFFFFF",
					"name": "Blanc"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "inter",
					"name": "Inter",
					"fontFamily": "Inter, \"Segoe UI\", Roboto, Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inter-latin-wght-normal.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inter-latin-ext-wght-normal.woff2"
							],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "x-small",
					"size": "12px",
					"name": "Très petit"
				},
				{
					"slug": "small",
					"size": "14px",
					"name": "Petit"
				},
				{
					"slug": "medium",
					"size": "16px",
					"name": "Normal"
				},
				{
					"slug": "large",
					"size": "20px",
					"name": "Grand",
					"fluid": {
						"min": "18px",
						"max": "20px"
					}
				},
				{
					"slug": "x-large",
					"size": "28px",
					"name": "Titre de section",
					"fluid": {
						"min": "24px",
						"max": "28px"
					}
				},
				{
					"slug": "xx-large",
					"size": "40px",
					"name": "Très grand",
					"fluid": {
						"min": "30px",
						"max": "40px"
					}
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [
				"px",
				"%",
				"em",
				"rem",
				"vw",
				"vh"
			],
			"spacingSizes": [
				{
					"slug": "10",
					"size": "6px",
					"name": "1"
				},
				{
					"slug": "20",
					"size": "12px",
					"name": "2"
				},
				{
					"slug": "30",
					"size": "18px",
					"name": "3"
				},
				{
					"slug": "40",
					"size": "24px",
					"name": "4"
				},
				{
					"slug": "50",
					"size": "32px",
					"name": "5"
				},
				{
					"slug": "60",
					"size": "48px",
					"name": "6"
				},
				{
					"slug": "70",
					"size": "56px",
					"name": "7"
				}
			]
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": true
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--blanc)",
			"text": "var(--wp--preset--color--texte)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--inter)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "18px",
			"padding": {
				"left": "24px",
				"right": "24px"
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--vert)"
				},
				"typography": {
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"text": "#0A5203"
					},
					"typography": {
						"textDecoration": "underline"
					}
				},
				":focus": {
					"typography": {
						"textDecoration": "underline"
					}
				}
			},
			"heading": {
				"typography": {
					"fontWeight": "700",
					"lineHeight": "1.25"
				},
				"color": {
					"text": "var(--wp--preset--color--texte)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"fontWeight": "800"
				},
				"color": {
					"text": "var(--wp--preset--color--vert)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				},
				"color": {
					"text": "var(--wp--preset--color--orange)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--vert)",
					"text": "var(--wp--preset--color--blanc)"
				},
				"border": {
					"radius": "4px"
				},
				"typography": {
					"fontSize": "15px",
					"fontWeight": "600"
				},
				"spacing": {
					"padding": {
						"top": "10px",
						"bottom": "10px",
						"left": "18px",
						"right": "18px"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--vert-fonce)",
						"text": "var(--wp--preset--color--blanc)"
					}
				}
			},
			"caption": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				"color": {
					"text": "var(--wp--preset--color--gris)"
				}
			}
		},
		"blocks": {
			"core/post-date": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-small)"
				},
				"color": {
					"text": "#6A6969"
				}
			},
			"core/post-excerpt": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"lineHeight": "1.55"
				},
				"color": {
					"text": "var(--wp--preset--color--gris)"
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--gris-bordure)"
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var(--wp--preset--color--vert)",
						"width": "4px",
						"style": "solid"
					}
				},
				"spacing": {
					"padding": {
						"left": "20px"
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "En-tête",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Pied de page",
			"area": "footer"
		}
	]
}
